# Copy to .env for local development. Never commit .env.
# The site works with none of these set: the chat then answers from built-in knowledge.

# --- MasterAPI: the shared backend for all my apps ---
# One connection gives this site: chat AI (Hugging Face models, tried in order), contact mail, a saved profile
# and admin passcode (so they survive redeploys), and the API page. Without it the site still works: the chat
# uses built-in answers and the profile is kept in local files.
# Create an app in the MasterAPI console and copy the two lines it shows you. Server-side only.
MASTERAPI_URL=
MASTERAPI_KEY=
# The Hugging Face token (HF_TOKEN) and the email key (RESEND_API_KEY) are set on MasterAPI, not here.

# --- Site ---
# Public address of the site, e.g. https://your-site.onrender.com
APP_URL=
# Other websites allowed to call this server, comma-separated. The site's own address is always allowed.
ALLOWED_ORIGINS=
# Passcode that unlocks the Data page (profile editor)
ADMIN_PASSCODE=
SESSION_SECRET=

# --- Contact form email, direct (optional) ---
# Only used if MasterAPI is not connected. With MasterAPI, it sends the email (free hosts block SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_RECIPIENT_EMAIL=

# --- Voice input in the chat (optional) ---
GEMINI_API_KEY=
