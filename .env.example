# Copy to .env and fill in. Never commit .env.

# --- Server ---
# Port the server listens on (Render sets this for you)
PORT=3000
# Public address of this site, used in links and emails. e.g. https://yourname.onrender.com
APP_URL=
# Comma-separated sites allowed to call the API (defaults to localhost)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI (server side, optional: the chat still works without them) ---
# Hugging Face or OpenRouter key used for server-side answers
OPENROUTER_API_KEY=
DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct
# Gemini key for audio transcription and the Gemini answer path
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Database (optional: enables saving planner data in PostgreSQL) ---
DATABASE_URL=
PGSSL_REJECT_UNAUTHORIZED=true

# --- Protecting write routes ---
# Shared secret required for POST/DELETE planner and goal routes.
# The same value goes in VITE_API_WRITE_KEY for the front end.
API_WRITE_KEY=
VITE_API_WRITE_KEY=

# --- Email (contact form and reports; optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kamo's AI <you@example.com>"
CONTACT_RECIPIENT_EMAIL=

# --- Front end (Vite) ---
# Base URL of the backend, if the front end is hosted apart from it (no trailing slash)
VITE_API_URL=

# MasterAPI (optional): when set, goals and contact messages are saved to MasterAPI.
# Server-side only. Create an app key in the MasterAPI console.
MASTERAPI_URL=
MASTERAPI_KEY=
