# VITE_API_URL: Base URL of the Render backend (no trailing slash)
VITE_API_URL="https://kamo-portfolio-ai.onrender.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Required for all AI features
GEMINI_API_KEY=

# GEMINI_MODEL: Gemini model identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# OPENROUTER_API_KEY: Required for all AI features
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# DEFAULT_MODEL: Optional default model for OpenRouter
DEFAULT_MODEL="meta-llama/llama-3.3-70b-instruct"

# DATABASE_URL: PostgreSQL connection string (e.g., from Render)
DATABASE_URL="postgres://user:password@host/dbname"

# VITE_RENDER_API_URL: Custom Render backend chat API endpoint
VITE_RENDER_API_URL="https://YOUR-RENDER-URL.onrender.com/api/chat"

# RENDER_BACKEND_URL: Upstream Render backend service URL
RENDER_BACKEND_URL=""

# RENDER_BACKEND_TIMEOUT_MS: Timeout for upstream Render backend calls in ms (defaults to 30000)
RENDER_BACKEND_TIMEOUT_MS="30000"

# SMTP Settings for sending automated emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user"
SMTP_PASS="password"
SMTP_FROM="user@example.com"
CONTACT_RECIPIENT_EMAIL="kamogelomosiah@gmail.com"

# ALLOWED_ORIGINS: Comma-separated allowlist for CORS (defaults to localhost:3000, localhost:5173, 127.0.0.1)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# PGSSL_REJECT_UNAUTHORIZED: Controls PostgreSQL certificate verification (defaults to true)
PGSSL_REJECT_UNAUTHORIZED="true"

# ADMIN_PASSCODE: Passcode for unlocking the Profile Data / JSON Knowledge Manager
ADMIN_PASSCODE=

