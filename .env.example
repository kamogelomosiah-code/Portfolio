# Copy to .env for local development. Never commit .env.
# The site works with none of these set: the chat then answers from built-in knowledge.

# --- Chat AI: Hugging Face ---
# Create a token at https://huggingface.co/settings/tokens (a "Read" token is enough).
HF_TOKEN=
# Optional: a model to try first. Otherwise Qwen/Qwen2.5-7B-Instruct, then meta-llama/Llama-3.2-3B-Instruct.
HF_MODEL=

# --- Site ---
# Public address of the site, e.g. https://your-site.onrender.com
APP_URL=
# Other websites allowed to call this server, comma-separated. The site's own address is always allowed.
ALLOWED_ORIGINS=
# Passcode that unlocks the Data page (profile editor)
ADMIN_PASSCODE=
SESSION_SECRET=

# --- Contact form email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_RECIPIENT_EMAIL=

# --- Voice input in the chat (optional) ---
GEMINI_API_KEY=

# --- MasterAPI (optional): turns on the "API" page and saves contact messages there ---
# Server-side only. Create an app key in the MasterAPI console.
MASTERAPI_URL=
MASTERAPI_KEY=
